# Copy to .env.local for local development, or set in the Vercel project settings.

# Base URL of the FastAPI backend (no trailing slash).
# Local development: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Supabase (persistence layer — V4) ────────────────────────────────────────
# Leave BLANK to run the app in stateless mode (public AI pages keep working;
# auth/campaign routes stay disabled). Fill in to enable sign in + campaigns.
# Project URL, e.g. https://abcdefgh.supabase.co  (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe to expose to the browser; RLS enforced server-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Content-Security-Policy ──────────────────────────────────────────────────
# off | report-only | enforce.  Default: report-only in production, off in dev
# (Turbopack HMR needs eval + websockets, and dev-only violations train people
# to ignore the report).
#
# The policy's origins are DERIVED from NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_API_URL above — if either is unset no CSP is emitted at all,
# because a policy naming the wrong origins breaks sign-in and every analysis
# call while pages still render.
#
# Promote to `enforce` once the violation report is quiet. Note that
# script-src includes 'unsafe-inline' (the App Router bootstraps from inline
# script), so this does NOT stop injected inline script; it stops script from
# unlisted origins, framing, form hijacking, and exfiltration to any host not
# named in connect-src.
# CSP_MODE=report-only

# ── SEO ──────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Defaults to https://hirevo.in.
# Set it on preview deployments so a preview URL does not claim to be
# production and outrank the real site.
# NEXT_PUBLIC_SITE_URL=https://hirevo.in
