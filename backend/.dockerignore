# Keep the build context small and — more importantly — keep secrets out of the
# image. `.env` / `.env.local` hold the service-role key; a COPY . . would bake
# them into a layer that survives any later deletion.
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local scratch and generated artifacts.
uploads/
*.log
openapi*.tmp.json
.DS_Store

# Tests and fixtures are not needed to serve traffic. CI runs them against the
# source checkout, not the image, so excluding them keeps the runtime lean.
tests/
