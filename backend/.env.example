# Copy to .env.local (or .env) and fill in real values.
# On Railway/Render, set these as environment variables instead.

# Deployment environment: development | staging | production
ENVIRONMENT=development

# Groq API key (required for LLM analysis endpoints). Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Ephemeral per-request upload directory used by /ats-analysis and /match-analysis.
# Leave unset to use the OS temp dir (works on serverless /tmp, Railway, Render).
# TEMP_UPLOAD_DIR=/tmp/hirelens_uploads

# Maximum upload size in megabytes.
MAX_FILE_SIZE_MB=10

# Allowed resume file extensions (JSON list).
ALLOWED_EXTENSIONS=[".pdf", ".docx"]

# Comma-separated list of allowed CORS origins, e.g.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# "*" allows any origin (credentials disabled in that case).
ALLOWED_ORIGINS=*

# ── Supabase (persistence layer — V4) ────────────────────────────────────────
# Leave BLANK to run the app fully stateless (existing AI endpoints unaffected).
# Fill in to enable auth, campaigns, and persistence.
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key (safe for clients; RLS enforced). Settings → API.
SUPABASE_ANON_KEY=
# Service role key — TRUSTED backend only, bypasses RLS. NEVER expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to verify user access tokens (Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=
# Signed URL lifetime for private file downloads (seconds).
SIGNED_URL_TTL_SECONDS=3600

# ── AI providers (provider-agnostic layer) ──────────────────────────────────
# Selection is config-only. Pick the platform-wide reasoning provider:
#   AI_PROVIDER=groq | anthropic | gemini | kimi | openai | openrouter
# Each provider reads its own key (only set the ones you use):
# GROQ_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...
# MOONSHOT_API_KEY=...                           # Kimi / Moonshot AI
# Per-provider overrides (timeout/retries/default_model); anything omitted falls
# back to the global AI_* defaults. Keys accept names or aliases ("claude","moonshot").
# AI_PROVIDERS={"groq":{"timeout":30,"retries":3,"default_model":"llama-3.3-70b-versatile"},"claude":{"timeout":60}}
# Capability→provider routing (STRUCTURE ONLY; inert until enabled):
# AI_ENABLE_CAPABILITY_ROUTING=false
# AI_CAPABILITY_ROUTING={"resume_analysis":"gemini","interview_generation":"anthropic"}

# ── Runtime tenant-isolation suite (tests/test_tenant_isolation.py) ───────────
# DESTRUCTIVE: creates & deletes real users/data. NEVER point at production.
# The suite aborts unless HL_ALLOW_DESTRUCTIVE_TESTS=1 AND ENVIRONMENT is non-prod.
# HL_ALLOW_DESTRUCTIVE_TESTS=1
# HL_TEST_BASE_URL=http://localhost:8000        # running backend under test
# HL_TEST_EMAIL_DOMAIN=example.com              # domain for throwaway test users
# HL_TEST_PASSWORD=                             # optional; a strong default is used
