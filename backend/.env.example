# Copy to .env.local (or .env) and fill in real values.
# On Railway/Render, set these as environment variables instead.
#
# This file lists the variables the V1 backend actually reads. V1 is:
#   reasoning = Groq · database/auth/storage = Supabase · payments = Razorpay
# Anything not here has a safe default in app/core/config.py.

# ── Core ─────────────────────────────────────────────────────────────────────
# Deployment environment: development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins, e.g.
#   ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# Deliberately EMPTY by default. In development/staging an unset value means
# "any origin"; in PRODUCTION an unset value refuses to boot — a safe posture
# must not depend on remembering a setting.
ALLOWED_ORIGINS=

# Trust `X-Forwarded-For` when deriving the client IP for rate limiting.
# Enable ONLY when a proxy that overwrites the header sits in front of the app
# (Render, Vercel, an ALB). Off by default so a directly-exposed instance
# cannot be fooled by a spoofed header.
TRUST_PROXY_HEADERS=false

# ── Reasoning provider (Groq) ────────────────────────────────────────────────
# Required for the LLM analysis endpoints. Without it the app still parses
# résumés; /ats-analysis and /match-analysis return 503.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# ── Uploads ──────────────────────────────────────────────────────────────────
# Ephemeral per-request upload directory used by /ats-analysis and /match-analysis.
# Leave unset to use the OS temp dir (works on serverless /tmp, Railway, Render).
# TEMP_UPLOAD_DIR=/tmp/hirelens_uploads

# Maximum upload size in megabytes.
MAX_FILE_SIZE_MB=10

# Allowed resume file extensions (JSON list).
ALLOWED_EXTENSIONS=[".pdf", ".docx"]

# Maximum number of résumés accepted in a single recruiter batch request.
MAX_BATCH_SIZE=100

# ── Supabase (database · auth · storage) ─────────────────────────────────────
# Leave BLANK to run the app fully stateless (the public AI endpoints keep
# working). Fill in to enable auth, campaigns, and persistence.
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key (safe for clients; RLS enforced). Settings → API.
SUPABASE_ANON_KEY=
# Service role key — TRUSTED backend only, bypasses RLS. NEVER expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to verify user access tokens (Settings → API → JWT Secret).
# Projects issuing asymmetric (ES256/RS256) tokens can leave this blank: the
# JWKS endpoint is derived from SUPABASE_URL automatically.
SUPABASE_JWT_SECRET=
# Signed URL lifetime for private file downloads (seconds).
SIGNED_URL_TTL_SECONDS=3600

# ── Embeddings (semantic search — separate from the LLM) ─────────────────────
# PRODUCTION uses NVIDIA NIM. `hashing` is the offline/dev fallback: it is
# dependency-free and needs no key, so a local checkout and CI work with no
# network. Select it explicitly — there is deliberately no automatic downgrade
# from nvidia to hashing, because the two produce different-width vectors and
# cosine similarity returns 0.0 on a mismatch, which would degrade search
# silently instead of failing.
#
#   production : EMBEDDING_PROVIDER=nvidia
#   offline/dev: EMBEDDING_PROVIDER=hashing
EMBEDDING_PROVIDER=hashing
# nvidia/nemotron-3-embed-1b when EMBEDDING_PROVIDER=nvidia; hashing-v1 otherwise.
EMBEDDING_MODEL=hashing-v1
# API key for the NVIDIA NIM embedding provider (https://build.nvidia.com).
# Required only when EMBEDDING_PROVIDER=nvidia.
NVIDIA_API_KEY=
# Hash-bucket count for the `hashing` provider — a REAL input there.
# IGNORED by the nvidia provider: that model determines its own output width,
# which is derived from the first live response. If this value disagrees with
# the model's actual dimension the provider logs a warning; the model wins.
#
# MEASURED against the live API on 2026-08-07: nvidia/nemotron-3-embed-1b
# returns 2048-dimension unit-normalised vectors. Recorded here as an
# operational fact, NOT as a value the nvidia provider reads.
EMBEDDING_DIMENSIONS=1536
# What a boot should do when stored embeddings came from a DIFFERENT model than
# the active one (a reindex that was never run, or did not finish). Those rows
# score 0.0 against every query and disappear from semantic search without any
# error — this check is what makes that visible.
#   warn (default) — log it; ERROR in production, WARNING elsewhere
#   fail           — refuse to boot until the reindex is done
#   off            — skip the check
EMBEDDING_STALENESS_ACTION=warn

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Credentials come from the environment only — nothing is hardcoded and there
# is no working default. Key ids are prefixed rzp_test_ / rzp_live_, and the
# provider refuses to process a live-mode webhook while holding test creds.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The webhook secret from the Razorpay dashboard. A DIFFERENT value from the
# key secret above — they sign different things.
RAZORPAY_WEBHOOK_SECRET=
# Plans are created once in the dashboard and bound here by id; the app never
# creates one at runtime. All are verified at boot against lib/pricing.ts.
# The trials are ONE-TIME purchases sold as single-cycle subscriptions
# (₹99 and ₹149; see app/billing/providers/razorpay/plans.py).
RAZORPAY_PLAN_TRIAL_INR=
RAZORPAY_PLAN_TRIAL_INTERVIEW_INR=
RAZORPAY_PLAN_PLUS_INR=
RAZORPAY_PLAN_PRO_INR=

# Monetization enforcement rollback lever: "on" (default) enforces plan limits
# and feature entitlements with a 402; "off" disables every gate without a deploy.
ENTITLEMENT_ENFORCEMENT=on

# ── Runtime tenant-isolation suite (tests/test_tenant_isolation.py) ───────────
# DESTRUCTIVE: creates & deletes real users/data. NEVER point at production.
# The suite aborts unless HL_ALLOW_DESTRUCTIVE_TESTS=1 AND ENVIRONMENT is non-prod.
# HL_ALLOW_DESTRUCTIVE_TESTS=1
# HL_TEST_BASE_URL=http://localhost:8000        # running backend under test
# HL_TEST_EMAIL_DOMAIN=example.com              # domain for throwaway test users
# HL_TEST_PASSWORD=                             # optional; a strong default is used
