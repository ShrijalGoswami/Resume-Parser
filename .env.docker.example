# Copy to .env.docker and fill in. Used only by docker-compose.yml.
#
#   docker compose --env-file .env.docker up --build
#
# Use a STAGING Supabase project. The stack talks to a real Supabase instance
# (see the comment at the top of docker-compose.yml for why), so pointing it at
# production means container experiments write production rows.

ENVIRONMENT=staging

# Browser-visible origin of the frontend. Must match what you actually load.
ALLOWED_ORIGINS=http://localhost:3000

# Resolved by the browser, so it must be the published host port — not http://api:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Supabase (staging project) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses RLS. Server-side only — never give this a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ───────────────────────────────────────────────────────────────────────
# Without this the app still parses résumés; AI endpoints return 503.
GROQ_API_KEY=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
